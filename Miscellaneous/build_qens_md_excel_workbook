# build_systems_sheet()
# ════════════════════════════════════════════════════════════════════════════
def build_systems_sheet(wb):
    ws = wb.active
    ws.title = "Systems"
    for col, w in [("A", 28), ("B", 18), ("C", 18), ("D", 20), ("E", 32)]:
        ws.column_dimensions[col].width = w
    ws.row_dimensions[1].height = 28

    merge_hdr(ws, "A1:E1",
              "QENS / MD DATA ANALYSIS  —  MASTER INDEX", C_HDR)
    for ci, h in enumerate(
        ["System", "Zeolite", "Molecule", "Temperatures (K)", "Notes"], 1
    ):
        style_subhdr(ws.cell(2, ci), h)

    for ri, (sname, slong, zeolite, molecule, _) in enumerate(SYSTEMS, 3):
        for ci, val in enumerate(
            [slong, zeolite, molecule,
             ", ".join(str(t) for t in TEMPS), ""], 1
        ):
            c = ws.cell(ri, ci)
            c.value = val
            c.font  = Font(name="Arial", size=10)
            c.border = bdr(); c.alignment = lft()

    # Q-grid reference tables
    row = 7
    ws.cell(row, 1).value = "Q-axis definitions (Å⁻¹)"
    ws.cell(row, 1).font  = Font(name="Arial", size=10, bold=True)

    for label, qgrid, col in [
        ("H-Y Q-grid",    Q_HY,    1),
        ("H-ZSM-5 Q-grid",Q_HZSM5, 3),
        ("MD Q-grid",     Q_MD,    5),
    ]:
        style_subhdr(ws.cell(row + 1, col), label)
        for i, q in enumerate(qgrid):
            c = ws.cell(row + 2 + i, col)
            c.value = q; c.number_format = "0.000000"
            c.font = Font(name="Arial", size=10)
            c.border = bdr(); c.alignment = ctr()

    # Legend
    lr = 30
    ws.cell(lr, 1).value = "COLOUR LEGEND"
    ws.cell(lr, 1).font  = Font(name="Arial", size=10, bold=True)
    for i, (bg, fg, desc) in enumerate([
        (C_INP_BG, C_BLU, "Input / free parameter (blue text) — cells you change"),
        (C_CAL_BG, C_GRN, "Calculated output (green text) — formula result"),
        (C_COM_BG, C_ORG, "Combined EISF (orange) — the curve fitted to data"),
        (C_RES_BG, C_RED, "Residual (red) — data minus calculated"),
        (C_WARN,   "000000","Model selector (yellow) — dropdown controls formula"),
        (C_FIX,    "555555","Fixed / non-editable reference value"),
    ]):
        c1 = ws.cell(lr + 1 + i, 1)
        c1.fill = fl(bg); c1.font = Font(name="Arial", size=10, color=fg)
        c1.value = "Sample text"; c1.border = bdr()
        c2 = ws.cell(lr + 1 + i, 2)
        c2.value = desc; c2.font = Font(name="Arial", size=10)
        ws.merge_cells(f"B{lr+1+i}:E{lr+1+i}")

    ws.sheet_properties.tabColor = "1F4E79"


