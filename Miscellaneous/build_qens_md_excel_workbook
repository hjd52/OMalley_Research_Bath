# build_md_isf_sheet()
# ════════════════════════════════════════════════════════════════════════════
def build_md_isf_sheet(wb):
    ws = wb.create_sheet("MD_ISF")
    end_col = get_column_letter(2 + len(SYSTEMS) * 20)
    merge_hdr(ws, f"A1:{end_col}1",
              "MD SIMULATION — INTERMEDIATE SCATTERING FUNCTION  F(Q,t)  [0 to ~66 ps]",
              C_HDR)
    style_subhdr(ws.cell(2, 1), "t (ps)")
    ws.column_dimensions["A"].width = 10

    for si, (sname, slong, _, _, _) in enumerate(SYSTEMS):
        c0 = 2 + si * 20
        sc = get_column_letter(c0); ec = get_column_letter(c0 + 18)
        ws.merge_cells(f"{sc}2:{ec}2")
        style_header(ws[f"{sc}2"], slong, C_SUBHDR)
        for qi, q in enumerate(Q_MD):
            c = ws.cell(3, c0 + qi)
            style_subhdr(c, f"Q={q:.1f}")
            ws.column_dimensions[get_column_letter(c0 + qi)].width = 9

    # log-spaced time axis 0.01 → 66 ps
    t_vals = [
        round(0.01 * (66 / 0.01) ** (math.log(i + 1) / math.log(41)), 4)
        for i in range(40)
    ]
    for ti, t in enumerate(t_vals):
        r = 4 + ti
        style_fix(ws.cell(r, 1), t)
        ws.cell(r, 1).number_format = "0.0000"
        for si in range(len(SYSTEMS)):
            c0 = 2 + si * 20
            for qi in range(19):
                style_inp(ws.cell(r, c0 + qi))

    ws.cell(46, 1).value = "← Add more time rows as needed"
    ws.cell(46, 1).font  = Font(name="Arial", size=9, italic=True, color="777777")
    ws.sheet_properties.tabColor = "ED7D31"


# ════════════════════════════════════════════════════════════════════════════
# build_comparison_sheet()
# ════════════════════════════════════════════════════════════════════════════
def build_comparison_sheet(wb):
    ws = wb.create_sheet("Comparison")
    merge_hdr(ws, "A1:N1",
              "COMPARISON — Fitted Parameters, Arrhenius Analysis, Cross-System Summary",
              C_HDR)
    ws.column_dimensions["A"].width = 26
    ws.column_dimensions["B"].width = 20
    for i in range(3, 15):
        ws.column_dimensions[get_column_letter(i)].width = 13

    # Arrhenius
    merge_hdr(ws, "A2:N2",
              "ARRHENIUS ANALYSIS  —  ln(Γ) vs 1000/T", C_SUBHDR)
    for ci, h in enumerate(
        ["System","Process",
         "1000/T 290K","1000/T 330K","1000/T 370K",
         "ln(Γ) 290K","ln(Γ) 330K","ln(Γ) 370K",
         "Ea (meV)","Ea (kJ/mol)","ln(Γ0)","Notes"], 1
    ):
        style_subhdr(ws.cell(3, ci), h)

    kB = 0.08617
    arr_rows = []
    for _, slong, _, _, _ in SYSTEMS:
        arr_rows += [(slong, "Process 1 (Γ1)"), (slong, "Process 2 (Γ2)")]

    for ri, (sys, proc) in enumerate(arr_rows):
        r = 4 + ri
        for ci, val in enumerate([sys, proc], 1):
            c = ws.cell(r, ci)
            c.value = val; c.font = Font(name="Arial", size=10)
            c.border = bdr(); c.alignment = lft()
        for ci2, T in enumerate([290, 330, 370], 3):
            c = ws.cell(r, ci2)
            style_fix(c, round(1000 / T, 6))
            c.number_format = "0.000000"
        for col in [6, 7, 8]:
            style_inp(ws.cell(r, col))
        l1=f"F{r}";l2=f"G{r}";l3=f"H{r}"
        t1=f"C{r}";t2=f"D{r}";t3=f"E{r}"
        ea = ws.cell(r, 9)
        ea.value = f"=IFERROR(-{kB}*1000*SLOPE({l1}:{l3},{t1}:{t3}),\"\")"
        style_calc(ea); ea.number_format = "0.0"
        kj = ws.cell(r, 10)
        kj.value = f"=IFERROR(I{r}*0.09648,\"\")"
        style_calc(kj); kj.number_format = "0.00"
        ic = ws.cell(r, 11)
        ic.value = f"=IFERROR(INTERCEPT({l1}:{l3},{t1}:{t3}),\"\")"
        style_calc(ic)

    ws.sheet_properties.tabColor = "C00000"


# ════════════════════════════════════════════════════════════════════════════
# MAIN — build everything and save
# ════════════════════════════════════════════════════════════════════════════
def main():
    wb = Workbook()

    # Build sheets in order
    build_systems_sheet(wb)
    build_models_sheet(wb)

    # Placeholder sheets that fitting sheets insert before
    wb.create_sheet("QENS_EISF")
    wb.create_sheet("QENS_HWHM")
    wb.create_sheet("MD_EISF")
    wb.create_sheet("MD_ISF")
    wb.create_sheet("Comparison")

    # Build fitting sheets — they insert themselves before QENS_EISF
    for sname, slong, zeolite, molecule, qgrid in SYSTEMS:
        build_fit_sheet(wb, sname, slong, zeolite, molecule, qgrid,
                        insert_before="QENS_EISF")

    # Now build the data and comparison sheets properly
    # (remove the placeholder sheets first)
    for name in ["QENS_EISF", "QENS_HWHM", "MD_EISF", "MD_ISF", "Comparison"]:
        del wb[name]

    build_qens_eisf_sheet(wb)
    build_qens_hwhm_sheet(wb)
    build_md_eisf_sheet(wb)
    build_md_isf_sheet(wb)
    build_comparison_sheet(wb)

    # Tab colours for data/comparison sheets
    for name, colour in [
        ("Systems",  "1F4E79"), ("Models", "1F4E79"),
        ("QENS_EISF","70AD47"), ("QENS_HWHM","70AD47"),
        ("MD_EISF",  "ED7D31"), ("MD_ISF","ED7D31"),
        ("Comparison","C00000"),
    ]:
        if name in wb.sheetnames:
            wb[name].sheet_properties.tabColor = colour

    wb.save(OUTPUT_PATH)
    print(f"Saved: {OUTPUT_PATH}")
    print(f"Sheets: {wb.sheetnames}")


if __name__ == "__main__":
    main()
