C_HDR    = "1F4E79"   # dark navy  — main headers
C_SUBHDR = "2E75B6"   # mid blue   — sub-headers / block headers
C_INP_BG = "DDEEFF"   # light blue — user input cells
C_CAL_BG = "EEFFEE"   # light green— calculated output cells
C_COM_BG = "FFF0E0"   # light orange — combined EISF column
C_RES_BG = "FFE0E0"   # light red  — residual columns
C_WARN   = "FFFF99"   # yellow     — model selector cells
C_FIX    = "F2F2F2"   # light grey — fixed / non-editable

C_WHT    = "FFFFFF"
C_BLU    = "0000FF"   # text colour: free parameter
C_GRN    = "008000"   # text colour: calculated
C_ORG    = "C55A11"   # text colour: combined EISF
C_RED    = "C00000"   # text colour: residual

def fl(h):
    return PatternFill("solid", start_color=h, fgColor=h)

def bdr():
    s = Side(style="thin", color="AAAAAA")
    return Border(left=s, right=s, top=s, bottom=s)

def ctr():
    return Alignment(horizontal="center", vertical="center", wrap_text=True)

def lft():
    return Alignment(horizontal="left", vertical="center", wrap_text=True)

def style_header(cell, text, bg=C_HDR):
    cell.value = text
    cell.font  = Font(name="Arial", size=10, bold=True, color=C_WHT)
    cell.fill  = fl(bg); cell.alignment = ctr(); cell.border = bdr()

def style_subhdr(cell, text):
    cell.value = text
    cell.font  = Font(name="Arial", size=9, bold=True, color=C_WHT)
    cell.fill  = fl(C_SUBHDR); cell.alignment = ctr(); cell.border = bdr()

def style_inp(cell, v=None):
    if v is not None: cell.value = v
    cell.font = Font(name="Arial", size=10, color=C_BLU)
    cell.fill = fl(C_INP_BG); cell.alignment = ctr(); cell.border = bdr()

def style_calc(cell, f=None, col=C_GRN, bg=C_CAL_BG):
    if f is not None: cell.value = f
    cell.font = Font(name="Arial", size=10, color=col)
    cell.fill = fl(bg); cell.alignment = ctr(); cell.border = bdr()
    cell.number_format = "0.00000"

def style_warn(cell, v=None):
    if v is not None: cell.value = v
    cell.font = Font(name="Arial", size=10, bold=True)
    cell.fill = fl(C_WARN); cell.alignment = ctr(); cell.border = bdr()

def style_fix(cell, v=None):
    if v is not None: cell.value = v
    cell.font = Font(name="Arial", size=10, color="555555")
    cell.fill = fl(C_FIX); cell.alignment = ctr(); cell.border = bdr()

def merge_hdr(ws, rng, text, bg=C_HDR):
    ws.merge_cells(rng)
    c = ws[rng.split(":")[0]]
    style_header(c, text, bg)

def add_note(ws, r, c_start, text, c_end):
    """Write italic grey note text, merging from c_start to c_end."""
    cell = ws.cell(r, c_start)
    cell.value = text
    cell.font  = Font(name="Arial", size=9, italic=True, color="777777")
    cell.alignment = lft()
    if c_end > c_start:
        try:
            ws.merge_cells(
                f"{get_column_letter(c_start)}{r}:"
                f"{get_column_letter(c_end)}{r}"
            )
        except Exception:
            pass


