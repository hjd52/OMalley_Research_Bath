# ════════════════════════════════════════════════════════════════════════════
# build_fit_sheet()
# Creates one fitting sheet for one system (e.g. H-ZSM-5 / Ethanol).
# Called once per entry in SYSTEMS.
# ════════════════════════════════════════════════════════════════════════════
def build_fit_sheet(wb, sheet_name, sys_long, zeolite, molecule,
                    q_grid, insert_before="QENS_EISF"):
    """
    wb           : openpyxl Workbook object
    sheet_name   : tab name
    sys_long     : long system name for the title bar
    zeolite      : zeolite label
    molecule     : molecule label
    q_grid       : list of default Q values (user can overwrite in the sheet)
    insert_before: name of sheet to insert before (keeps tab order clean)
    """
    idx = wb.sheetnames.index(insert_before)
    ws  = wb.create_sheet(sheet_name, idx)
    nq  = len(q_grid)
    tc  = BW * len(TEMPS)      # total columns across all temperature blocks
    BASE = 3                   # row where temperature blocks start

    # ── column widths ─────────────────────────────────────────────────────
    for i in range(1, tc + 3):
        ws.column_dimensions[get_column_letter(i)].width = 7.8
    # Q column in each block is slightly wider
    for ti in range(len(TEMPS)):
        ws.column_dimensions[get_column_letter(ti * BW + 1)].width = 11.0

    ws.row_dimensions[1].height = 26

    # ── sheet title ───────────────────────────────────────────────────────
    ws.merge_cells(f"A1:{get_column_letter(tc)}1")
    style_header(ws["A1"],
                 f"FITTING  —  {sys_long}  ({zeolite} / {molecule})",
                 C_HDR)

    # ── global ℏ cell (row 2, columns 1-2) ───────────────────────────────
    # All HWHM formulas reference this cell with an absolute address $B$2.
    # Change the value here if you want different units.
    ws.cell(2, 1).value = "ℏ  (meV·ps)"
    ws.cell(2, 1).font  = Font(name="Arial", size=10, bold=True)
    ws.cell(2, 1).alignment = lft()
    style_inp(ws.cell(2, 2), 0.6582)
    HBAR = "$B$2"   # absolute reference used in all HWHM formulas

    # ══════════════════════════════════════════════════════════════════════
    # TEMPERATURE BLOCKS
    # ══════════════════════════════════════════════════════════════════════
    for ti, T in enumerate(TEMPS):
        co = ti * BW + 1    # 1-indexed column where this block starts

        # helper: absolute row for a parameter at offset `off`
        def pr(off):
            return BASE + 2 + off

        # helper: column letter at offset `dc` within this block
        def ca(dc):
            return get_column_letter(co + dc)

        # helper: absolute cell address for parameter column B (col co+1)
        def fa(off):
            return f"${get_column_letter(co+1)}${pr(off)}"

        # ── block header ──────────────────────────────────────────────────
        ws.merge_cells(f"{ca(0)}{BASE}:{ca(BW-1)}{BASE}")
        style_header(ws[f"{ca(0)}{BASE}"], f"T = {T} K", C_SUBHDR)
        ws.row_dimensions[BASE].height = 18

        # ── column sub-headers ────────────────────────────────────────────
        ws.row_dimensions[BASE+1].height = 48
        for ci2, ht in enumerate(COL_HEADERS):
            c = ws.cell(BASE + 1, co + ci2)
            style_subhdr(c, ht)
            # special colours for combined and residual column headers
            if ci2 == 5:
                c.fill = fl("8B4513")
            elif ci2 in [6, 10, 14]:
                c.fill = fl("7B0000")

        # ── section banners ───────────────────────────────────────────────
        # These are the grey divider rows between parameter groups.
        # Adjust the (offset, text) pairs if you add parameter sections.
        sections = [
            (0,  "MODEL SELECTORS"),
            (6,  "EISF PARAMETERS"),
            (13, "HWHM PARAMETERS — GAMMA 1"),
            (19, "HWHM PARAMETERS — GAMMA 2"),
            (25, "GOODNESS OF FIT"),
        ]
        for off, txt in sections:
            r = pr(off)
            ws.merge_cells(f"{ca(0)}{r}:{ca(BW-1)}{r}")
            c = ws.cell(r, co)
            c.value = txt
            c.font  = Font(name="Arial", size=9, bold=True, color=C_BLU)
            c.fill  = fl("EEF4FF")
            c.alignment = lft()
            c.border = bdr()
            ws.row_dimensions[r].height = 13

        # ── model selectors (rows 1-5 within selector section) ────────────
        # TO ADD A NEW MODEL: add its name to EISF_MODELS or HWHM_MODELS
        # at the top of this file, then add a branch in eisf_ifs/hwhm_ifs.
        sel_rows = [
            (1, "No. Lorentzians",   2,            None,
             "1 or 2.  For 1 Lorentzian: set f = 0"),
            (2, "EISF Model P1",     EISF_MODELS[0], EISF_MODELS,
             "slower / localised process — drives EISF P1 column"),
            (3, "EISF Model P2",     EISF_MODELS[1], EISF_MODELS,
             "faster / diffusive process — drives EISF P2 column"),
            (4, "HWHM Model G1",     HWHM_MODELS[0], HWHM_MODELS,
             "drives Γ1 calc column — change dropdown to switch formula live"),
            (5, "HWHM Model G2",     HWHM_MODELS[0], HWHM_MODELS,
             "drives Γ2 calc column — can differ from G1 model"),
        ]
        for off, txt, default, choices, note_txt in sel_rows:
            r = pr(off)
            lc = ws.cell(r, co)
            lc.value = txt
            lc.font  = Font(name="Arial", size=10, bold=True)
            lc.alignment = lft(); lc.border = bdr()
            style_warn(ws.cell(r, co + 1), default)
            if choices:
                dv = DataValidation(
                    type="list",
                    formula1='"' + ",".join(choices) + '"',
                    allow_blank=False,
                )
                ws.add_data_validation(dv)
                dv.add(ws.cell(r, co + 1))
            add_note(ws, r, co + 2, note_txt, co + BW - 1)

        # absolute addresses of model selector cells
        M1  = fa(2)    # EISF P1 model
        M2  = fa(3)    # EISF P2 model
        MH1 = fa(4)    # HWHM G1 model
        MH2 = fa(5)    # HWHM G2 model

        # ── EISF parameters ───────────────────────────────────────────────
        eisf_params = [
            (7,  "p_total  (mobile fraction)",  0.80,
             "First estimate: the plateau of A0(Q) at high Q ≈ (1−p)"),
            (8,  "f  (weight of P2)",           0.30,
             "0 = all Process 1,  1 = all Process 2.  Set f=0 for single Lorentzian"),
            (9,  "a1  geometry P1  (Å)",        1.50,
             "radius, jump length etc.  Interpretation depends on P1 model"),
            (10, "N1  fold  (uniaxial P1)",     6,
             "integer: 3, 4, 5, 6 or 12  —  only used when P1 = Uniaxial N-fold"),
            (11, "a2  geometry P2  (Å)",        2.00,
             "geometry parameter for P2 model"),
            (12, "N2  fold  (uniaxial P2)",     3,
             "integer: 3, 4, 5, 6 or 12  —  only used when P2 = Uniaxial N-fold"),
        ]
        for off, txt, default, note_txt in eisf_params:
            r = pr(off)
            lc = ws.cell(r, co)
            lc.value = txt
            lc.font  = Font(name="Arial", size=10)
            lc.alignment = lft(); lc.border = bdr()
            style_inp(ws.cell(r, co + 1), default)
            add_note(ws, r, co + 2, note_txt, co + BW - 1)

        # absolute addresses of EISF parameter cells
        P  = fa(7)    # p_total
        F  = fa(8)    # f weighting
        A1 = fa(9)    # a1 geometry P1
        N1 = fa(10)   # N1 fold P1
        A2 = fa(11)   # a2 geometry P2
        N2 = fa(12)   # N2 fold P2

        # ── HWHM G1 parameters ────────────────────────────────────────────
        # TO ADD A NEW HWHM PARAMETER: add a row here, add a new offset
        # constant in the offsets section at the top of this file, and
        # update hwhm_ifs() to use it.
        hwhm_g1_params = [
            (14, "l1  jump length G1  (Å)",        2.0,
             "Chudley-Elliott — jump distance"),
            (15, "⟨r²⟩1  mean-sq jump G1  (Å²)",   4.0,
             "Hall-Ross and Singwi-Sjolander — mean-square jump length"),
            (16, "τ1  res. time G1  (ps)",           5.0,
             "Chudley-Elliott, Hall-Ross, and Singwi-Sjolander — residence time"),
            (17, "Ω1  rot. rate G1  (ps⁻¹)",        0.2,
             "Q-Independent (rotation) — rotational rate; HWHM = ℏ·Ω"),
        ]
        for off, txt, default, note_txt in hwhm_g1_params:
            r = pr(off)
            lc = ws.cell(r, co)
            lc.value = txt
            lc.font  = Font(name="Arial", size=10)
            lc.alignment = lft(); lc.border = bdr()
            style_inp(ws.cell(r, co + 1), default)
            add_note(ws, r, co + 2, note_txt, co + BW - 1)

        L1   = fa(14)   # l1 jump length (CE)
        LSQ1 = fa(15)   # <r²>1 (HR and SS)
        TAU1 = fa(16)   # τ1 (CE, HR, SS)
        ROT1 = fa(17)   # Ω1 rotational rate (Q-independent)

        # ── HWHM G2 parameters ────────────────────────────────────────────
        hwhm_g2_params = [
            (20, "l2  jump length G2  (Å)",        1.5,
             "Chudley-Elliott"),
            (21, "⟨r²⟩2  mean-sq jump G2  (Å²)",   2.0,
             "Hall-Ross and Singwi-Sjolander"),
            (22, "τ2  res. time G2  (ps)",           1.0,
             "Chudley-Elliott, Hall-Ross, and Singwi-Sjolander"),
            (23, "Ω2  rot. rate G2  (ps⁻¹)",        0.5,
             "Q-Independent (rotation)"),
        ]
        for off, txt, default, note_txt in hwhm_g2_params:
            r = pr(off)
            lc = ws.cell(r, co)
            lc.value = txt
            lc.font  = Font(name="Arial", size=10)
            lc.alignment = lft(); lc.border = bdr()
            style_inp(ws.cell(r, co + 1), default)
            add_note(ws, r, co + 2, note_txt, co + BW - 1)

        L2   = fa(20)
        LSQ2 = fa(21)
        TAU2 = fa(22)
        ROT2 = fa(23)

        # ── chi-sq placeholders ───────────────────────────────────────────
        for off, txt in [(26, "χ² EISF"), (27, "χ² Γ1"), (28, "χ² Γ2")]:
            r = pr(off)
            lc = ws.cell(r, co)
            lc.value = txt
            lc.font  = Font(name="Arial", size=10, bold=True)
            lc.alignment = lft(); lc.border = bdr()
            style_calc(ws.cell(r, co + 1))   # formula added after data rows

        # ── data table header ─────────────────────────────────────────────
        r_dh = pr(30)
        ws.merge_cells(f"{ca(0)}{r_dh}:{ca(BW-1)}{r_dh}")
        c = ws.cell(r_dh, co)
        c.value = (
            f"Q-DATA TABLE  —  {zeolite} / {molecule}  /  {T} K  "
            f"(Q column is editable — paste your Q values here)"
        )
        c.font  = Font(name="Arial", size=9, bold=True)
        c.fill  = fl("D9E1F2"); c.alignment = lft(); c.border = bdr()

        # ══════════════════════════════════════════════════════════════════
        # DATA ROWS
        # Row structure: Q | EISF data | EISF err | P1 | P2 | combined |
        #                resid | G1 data | G1 err | G1 calc | G1 resid |
        #                G2 data | G2 err | G2 calc | G2 resid
        # ══════════════════════════════════════════════════════════════════
        DS = BASE + 2 + PARAM_ROWS   # absolute row index where data starts

        # Column letter references (for formula strings and chi-sq ranges)
        cQ   = ca(0)    # Q values — formulas reference this as the Q address
        cED  = ca(1);  cEE = ca(2)    # EISF data, error
        cP1  = ca(3);  cP2 = ca(4)   # P1 and P2 components
        cCO  = ca(5);  cER = ca(6)   # combined, residual
        cG1D = ca(7);  cG1E= ca(8)   # G1 data, error
        cG1C = ca(9);  cG1R= ca(10)  # G1 calc, residual
        cG2D = ca(11); cG2E= ca(12)  # G2 data, error
        cG2C = ca(13); cG2R= ca(14)  # G2 calc, residual

        for qi, q in enumerate(q_grid):
            r   = DS + qi
            # q_cell_addr is the RELATIVE address of the Q value in this row.
            # Because it is relative, the EISF and HWHM formulas can be
            # dragged down the column and will update automatically.
            q_cell = f"{cQ}{r}"

            # Q column — blue/editable so user can overwrite with any Q grid
            style_inp(ws.cell(r, co + 0), q)
            ws.cell(r, co + 0).number_format = "0.000000"

            # EISF data and error — user input
            style_inp(ws.cell(r, co + 1))
            style_inp(ws.cell(r, co + 2))

            # ── EISF P1 component ─────────────────────────────────────────
            # Guard Q=0: all EISF models return 1 at Q=0, so we write 1
            # explicitly. For Q>0 we write the full IFS formula.
            # The q_cell reference (e.g. "A37") is RELATIVE so the formula
            # is draggable — if you drag it to another row the Q reference
            # updates automatically.
            if q == 0:
                style_calc(ws.cell(r, co + 3), "=1")
            else:
                style_calc(ws.cell(r, co + 3),
                           eisf_ifs(M1, q_cell, A1, N1))

            # ── EISF P2 component ─────────────────────────────────────────
            if q == 0:
                style_calc(ws.cell(r, co + 4), "=1")
            else:
                style_calc(ws.cell(r, co + 4),
                           eisf_ifs(M2, q_cell, A2, N2))

            # ── EISF combined: (1-p) + p*[(1-f)*P1 + f*P2] ───────────────
            cc = ws.cell(r, co + 5)
            cc.value = (
                f"=(1-{P})+{P}*((1-{F})*{cP1}{r}+{F}*{cP2}{r})"
            )
            cc.font  = Font(name="Arial", size=10, color=C_ORG)
            cc.fill  = fl(C_COM_BG)
            cc.alignment = ctr(); cc.border = bdr()
            cc.number_format = "0.00000"

            # ── EISF residual: data − combined ────────────────────────────
            rc = ws.cell(r, co + 6)
            rc.value = f'=IF({cED}{r}="","",{cED}{r}-{cCO}{r})'
            rc.font  = Font(name="Arial", size=10, color=C_RED)
            rc.fill  = fl(C_RES_BG)
            rc.alignment = ctr(); rc.border = bdr()
            rc.number_format = "0.00000"

            # G1 data and error
            style_inp(ws.cell(r, co + 7))
            style_inp(ws.cell(r, co + 8))

            # ── G1 calc ───────────────────────────────────────────────────
            if q == 0:
                style_calc(ws.cell(r, co + 9), "=0")
            else:
                style_calc(ws.cell(r, co + 9),
                           hwhm_ifs(MH1, q_cell, L1, LSQ1, TAU1, ROT1, HBAR))

            # ── G1 residual ───────────────────────────────────────────────
            g1r = ws.cell(r, co + 10)
            g1r.value = f'=IF({cG1D}{r}="","",{cG1D}{r}-{cG1C}{r})'
            g1r.font  = Font(name="Arial", size=10, color=C_RED)
            g1r.fill  = fl(C_RES_BG)
            g1r.alignment = ctr(); g1r.border = bdr()
            g1r.number_format = "0.00000"

            # G2 data and error
            style_inp(ws.cell(r, co + 11))
            style_inp(ws.cell(r, co + 12))

            # ── G2 calc ───────────────────────────────────────────────────
            if q == 0:
                style_calc(ws.cell(r, co + 13), "=0")
            else:
                style_calc(ws.cell(r, co + 13),
                           hwhm_ifs(MH2, q_cell, L2, LSQ2, TAU2, ROT2, HBAR))

            # ── G2 residual ───────────────────────────────────────────────
            g2r = ws.cell(r, co + 14)
            g2r.value = f'=IF({cG2D}{r}="","",{cG2D}{r}-{cG2C}{r})'
            g2r.font  = Font(name="Arial", size=10, color=C_RED)
            g2r.fill  = fl(C_RES_BG)
            g2r.alignment = ctr(); g2r.border = bdr()
            g2r.number_format = "0.00000"

        # ── chi-sq formulas ───────────────────────────────────────────────
        # Sum of squared residuals divided by number of data points entered.
        # Returns blank if no data has been entered yet.
        end_row = DS + nq - 1
        er  = f"{cER}{DS}:{cER}{end_row}"
        ed  = f"{cED}{DS}:{cED}{end_row}"
        g1r = f"{cG1R}{DS}:{cG1R}{end_row}"
        g1d = f"{cG1D}{DS}:{cG1D}{end_row}"
        g2r = f"{cG2R}{DS}:{cG2R}{end_row}"
        g2d = f"{cG2D}{DS}:{cG2D}{end_row}"

        ws.cell(pr(26), co + 1).value = (
            f'=IFERROR(SUMPRODUCT(({er})^2)/COUNTA({ed}),"")'
        )
        ws.cell(pr(27), co + 1).value = (
            f'=IFERROR(SUMPRODUCT(({g1r})^2)/COUNTA({g1d}),"")'
        )
        ws.cell(pr(28), co + 1).value = (
            f'=IFERROR(SUMPRODUCT(({g2r})^2)/COUNTA({g2d}),"")'
        )
        for off in [26, 27, 28]:
            style_calc(ws.cell(pr(off), co + 1))

    # ── footer note ───────────────────────────────────────────────────────
    fn = BASE + 2 + PARAM_ROWS + len(q_grid) + 2
    ws.merge_cells(f"A{fn}:{get_column_letter(tc)}{fn}")
    c = ws.cell(fn, 1)
    c.value = (
        "COLOUR KEY:  Blue = free parameter or editable Q  |  "
        "Yellow = model selector (dropdown switches formula live)  |  "
        "Green = EISF P1/P2 component calc  |  "
        "Orange = EISF combined (1−p)+p[(1−f)P1+fP2]  |  "
        "Red = residual  ||  "
        "SINGLE LORENTZIAN: set f=0.  "
        "Q column is editable — paste your Q values to use a different Q grid."
    )
    c.font = Font(name="Arial", size=9, italic=True, color="444444")
    c.alignment = lft()

    ws.sheet_properties.tabColor = "2E75B6"


