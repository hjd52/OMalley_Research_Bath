# ────────────────────────────────────────────────────────────────────────────
# eisf_ifs()
# Returns an Excel formula string for the EISF at a given Q.
#
# Arguments:
#   mdl_addr : Excel address of the EISF model dropdown cell, e.g. "$B$7"
#   q_addr   : Excel address of the Q value cell in the data row, e.g. "A37"
#              (this is a relative reference so formulas are draggable)
#   a_addr   : Excel address of the geometry parameter a (absolute), e.g. "$B$14"
#   N_addr   : Excel address of the N-fold integer parameter (absolute)
#
# HOW TO ADD A NEW EISF MODEL:
#   1. Add its name string to EISF_MODELS above.
#   2. Write the Excel formula as a Python string using the address variables.
#      Use q_addr wherever Q appears (keeps it draggable).
#   3. Add a new line to the IFS string following the same pattern as the others:
#         f'{mdl_addr}="My New Model", <formula>,'
#      Insert it before the final TRUE,0 fallback line.
# ────────────────────────────────────────────────────────────────────────────
def eisf_ifs(mdl_addr, q_addr, a_addr, N_addr):
    """
    Build the full IFS Excel formula for EISF.
    q_addr is a relative cell reference (e.g. 'A37') so the formula is
    draggable down the Q column without breaking.
    Returns '=1' at Q=0 rows (handled by the Q=0 guard in build_fit_sheet).
    """
    q = q_addr   # shorthand

    # ── Isotropic Rotation (Sears): [sin(Qa)/Qa]^2 ──────────────────────────
    iso = (
        f"(SIN({q}*{a_addr})/({q}*{a_addr}))^2"
    )

    # ── 3-Site Jump: (1/3)*(1 + 2*j0(Q*a*sqrt(3))) ──────────────────────────
    ts = (
        f"(1/3)*(1+2*(SIN({q}*{a_addr}*SQRT(3))/({q}*{a_addr}*SQRT(3))))"
    )

    # ── Uniaxial N-fold rotation ─────────────────────────────────────────────
    # A0 = (1/N) * sum_{j=0}^{N-1} j0(2*Q*a*sin(pi*j/N))
    # Excel can't do symbolic sums, so we pre-expand for each allowed N.
    # j=0 term is always j0(0) = 1.
    # TO ADD A NEW N VALUE: add another entry to the IFS below following the
    # same pattern as the others.
    def uni(N_val):
        terms = ["1"]   # j=0 → j0(0) = 1
        for j in range(1, N_val):
            arg = f"2*{q}*{a_addr}*SIN(PI()*{j}/{N_val})"
            terms.append(f"SIN({arg})/({arg})")
        return f"(1/{N_val})*({'+'.join(terms)})"

    uniaxial = (
        f"IFS({N_addr}=3,{uni(3)},{N_addr}=4,{uni(4)},"
        f"{N_addr}=5,{uni(5)},{N_addr}=6,{uni(6)},"
        f"{N_addr}=12,{uni(12)},TRUE,{uni(6)})"
    )

    # ── Diffusion in Sphere (Bicout-Zaccai): [3*j1(Qa)/(Qa)]^2 ─────────────
    # j1(x) = (sin(x) - x*cos(x)) / x^2
    qa  = f"({q}*{a_addr})"
    j1  = f"(SIN({qa})-{qa}*COS({qa}))/({qa})^2"
    sph = f"(3*({j1})/({qa}))^2"

    # ── Diffusion on Sphere Surface: same form as isotropic rotation ─────────
    dos = iso

    # ── Fixed (completely immobile fraction) ─────────────────────────────────
    fix = "1"

    # ── Assemble IFS ─────────────────────────────────────────────────────────
    # Pattern: model_addr="Name", formula, ...
    # Add new models before the TRUE,0 fallback.
    formula = (
        f'=IFS('
        f'{mdl_addr}="Isotropic Rotation",{iso},'
        f'{mdl_addr}="3-Site Jump",{ts},'
        f'{mdl_addr}="Uniaxial N-fold",{uniaxial},'
        f'{mdl_addr}="Diffusion in Sphere",{sph},'
        f'{mdl_addr}="Diffusion on Sphere",{dos},'
        f'{mdl_addr}="Fixed (EISF=1)",{fix},'
        f'TRUE,0)'          # fallback if dropdown value not recognised
    )
    return formula


# ────────────────────────────────────────────────────────────────────────────
# hwhm_ifs()
# Returns an Excel formula string for the HWHM (linewidth) at a given Q.
#
# Arguments:
#   mdl_addr : Excel address of the HWHM model dropdown cell (absolute)
#   q_addr   : Excel address of the Q value cell (relative — draggable)
#   l_addr   : jump length l for Chudley-Elliott (absolute)
#   lsq_addr : mean-square jump length <r²> shared by Hall-Ross and SS (absolute)
#   tau_addr : residence time τ shared by CE, HR, and SS (absolute)
#   rot_addr : rotational rate Omega for Q-independent model (absolute), in ps⁻¹
#   hbar_addr: cell containing ℏ in meV·ps (absolute, shared global cell)
#
# Singwi-Sjolander form used here (corrected):
#   Δω(Q) = (1/6τ) * Q²<r²> * [1 + Q²<r²>/6]⁻¹
#   Which rearranges to:
#   Δω(Q) = hbar * (Q²<r²>/6τ) / (1 + Q²<r²>/6)
#   Note: <r²> = lsq_addr, τ = tau_addr
#   This does NOT require D as a separate parameter — D emerges as <r²>/(6τ).
#
# HOW TO ADD A NEW HWHM MODEL:
#   1. Add its name to HWHM_MODELS above.
#   2. Write the Excel formula string using the address variables and q_addr.
#   3. Add a new parameter row in the parameter block section of build_fit_sheet()
#      if your model needs a parameter not already present.
#   4. Add a branch here before the TRUE,0 fallback.
# ────────────────────────────────────────────────────────────────────────────
def hwhm_ifs(mdl_addr, q_addr, l_addr, lsq_addr, tau_addr, rot_addr, hbar_addr):
    """
    Build the full IFS Excel formula for HWHM linewidth.
    q_addr is relative (draggable). All parameter addresses are absolute.
    Returns '=0' for Q=0 rows (see build_fit_sheet Q=0 guard).
    """
    q = q_addr

    # ── Chudley-Elliott: (ℏ/τ) * [1 - sin(Ql)/(Ql)] ────────────────────────
    Ql = f"({q}*{l_addr})"
    CE = f"({hbar_addr}/{tau_addr})*(1-SIN({Ql})/({Ql}))"

    # ── Hall-Ross: (ℏ/τ) * [1 - exp(-Q²<r²>/6)] ────────────────────────────
    HR = f"({hbar_addr}/{tau_addr})*(1-EXP(-({q}^2*{lsq_addr})/6))"

    # ── Singwi-Sjolander (corrected form) ───────────────────────────────────
    # Δω(Q) = hbar * (Q²<r²>/6τ) / (1 + Q²<r²>/6)
    # Written as: hbar * Q²<r²> / (6τ + τ*Q²<r²>)   [factoring out τ]
    # <r²> = lsq_addr, τ = tau_addr
    # Effective diffusion coefficient: D = <r²>/(6τ) emerges naturally.
    SS = (
        f"({hbar_addr}*{q}^2*{lsq_addr})"
        f"/(6*{tau_addr}+{tau_addr}*{q}^2*{lsq_addr}/6*6)"
    )
    # Cleaner equivalent form:
    # numerator   = hbar * Q² * <r²>
    # denominator = 6*tau * (1 + Q²*<r²>/6)
    SS = (
        f"({hbar_addr}*{q}^2*{lsq_addr})"
        f"/(6*{tau_addr}*(1+{q}^2*{lsq_addr}/6))"
    )

    # ── Q-Independent (rotation): flat line at value Omega ──────────────────
    # For rotational processes where HWHM does not depend on Q.
    # rot_addr holds Omega in ps⁻¹; multiply by hbar to get meV.
    # If your Omega is already in meV, just use rot_addr directly without hbar.
    QIND = f"{hbar_addr}*{rot_addr}"

    # ── Assemble IFS ─────────────────────────────────────────────────────────
    formula = (
        f'=IFS('
        f'{mdl_addr}="Chudley-Elliott",{CE},'
        f'{mdl_addr}="Hall-Ross",{HR},'
        f'{mdl_addr}="Singwi-Sjolander",{SS},'
        f'{mdl_addr}="Q-Independent (rotation)",{QIND},'
        f'TRUE,0)'
    )
    return formula


