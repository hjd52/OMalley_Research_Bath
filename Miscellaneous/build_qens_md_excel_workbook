# build_models_sheet()
# Human-readable reference for all model expressions.
# ════════════════════════════════════════════════════════════════════════════
def build_models_sheet(wb):
    ws = wb.create_sheet("Models")
    for col, w in [("A", 32), ("B", 22), ("C", 58), ("D", 42)]:
        ws.column_dimensions[col].width = w
    merge_hdr(ws, "A1:D1",
              "MODELS LIBRARY — EISF and HWHM expressions", C_HDR)

    # EISF models
    merge_hdr(ws, "A2:D2", "EISF MODELS", C_SUBHDR)
    for ci, h in enumerate(
        ["Model Name", "Parameter(s)", "Mathematical Form", "Physical Notes"], 1
    ):
        style_subhdr(ws.cell(3, ci), h)

    eisf_rows = [
        ("Isotropic Rotation (Sears)",
         "a = radius (Å)",
         "A0(Q) = [sin(Qa)/(Qa)]²",
         "Spherical Bessel j0; isotropic tumbling on sphere of radius a"),
        ("3-Site Jump Rotation",
         "a = C–C jump distance (Å)",
         "A0(Q) = ⅓·(1 + 2·j0(Q·a·√3))",
         "Equilateral triangle of sites; side length a"),
        ("Uniaxial Rotation (N-fold)",
         "a = radius (Å),  N = fold (integer)",
         "A0(Q) = (1/N)·Σⱼ j0(2Qa·sin(πj/N)),  j=0…N−1",
         "Discrete N-fold jumps around rotation axis; N = 3,4,5,6,12 supported"),
        ("Diffusion in Sphere (Bicout-Zaccai)",
         "a = sphere radius (Å)",
         "A0(Q) = [3·j1(Qa)/(Qa)]²,  j1(x)=(sin(x)−x·cos(x))/x²",
         "Centre-of-mass diffusion inside a hard confining sphere"),
        ("Diffusion on Sphere Surface",
         "a = sphere radius (Å)",
         "A0(Q) = [sin(Qa)/(Qa)]²",
         "Same functional form as Sears — distinct physical picture"),
        ("Fixed (EISF=1)",
         "—",
         "A0(Q) = 1",
         "Fully immobile fraction; contributes a flat line at 1"),
    ]
    for i, row in enumerate(eisf_rows):
        r = 4 + i
        for ci, val in enumerate(row, 1):
            c = ws.cell(r, ci)
            c.value = val; c.font = Font(name="Arial", size=10)
            c.border = bdr(); c.alignment = lft()
        ws.cell(r, 1).fill = fl(C_FIX)
        ws.row_dimensions[r].height = 26

    # HWHM models
    r_h = 12
    merge_hdr(ws, f"A{r_h}:D{r_h}", "HWHM / LINEWIDTH MODELS", C_SUBHDR)
    for ci, h in enumerate(
        ["Model Name", "Parameter(s)", "Mathematical Form", "Physical Notes"], 1
    ):
        style_subhdr(ws.cell(r_h + 1, ci), h)

    hwhm_rows = [
        ("Chudley-Elliott",
         "l = jump length (Å)\nτ = residence time (ps)",
         "Γ(Q) = (ℏ/τ)·[1 − sin(Ql)/(Ql)]",
         "Jump diffusion; Q→0 limit gives D = l²/(6τ)"),
        ("Hall-Ross",
         "⟨r²⟩ = mean-sq jump (Å²)\nτ = residence time (ps)",
         "Γ(Q) = (ℏ/τ)·[1 − exp(−Q²⟨r²⟩/6)]",
         "Gaussian distribution of jump lengths"),
        ("Singwi-Sjolander (corrected)",
         "⟨r²⟩ = mean-sq jump (Å²)\nτ = residence time (ps)",
         "Γ(Q) = ℏ·Q²⟨r²⟩ / (6τ·(1 + Q²⟨r²⟩/6))\n"
         "Effective D = ⟨r²⟩/(6τ) emerges — not a free parameter",
         "Two-state model; uses same ⟨r²⟩ and τ as Hall-Ross for easy comparison"),
        ("Q-Independent (rotation)",
         "Ω = rotational rate (ps⁻¹)",
         "Γ(Q) = ℏ·Ω  [constant, no Q dependence]",
         "Purely rotational process; flat horizontal line in Γ vs Q plot"),
    ]
    for i, row in enumerate(hwhm_rows):
        r = r_h + 2 + i
        for ci, val in enumerate(row, 1):
            c = ws.cell(r, ci)
            c.value = val; c.font = Font(name="Arial", size=10)
            c.border = bdr(); c.alignment = lft()
        ws.cell(r, 1).fill = fl(C_FIX)
        ws.row_dimensions[r].height = 36

    # Combined EISF formula
    r_c = r_h + 8
    merge_hdr(ws, f"A{r_c}:D{r_c}",
              "COMBINED EISF FORMULA (one or two components)", C_SUBHDR)
    ws.cell(r_c + 1, 1).value = (
        "A0(Q) = (1 − p) + p · [ (1−f)·EISF1(Q)  +  f·EISF2(Q) ]"
    )
    ws.cell(r_c + 1, 1).font = Font(name="Arial", size=12, bold=True,
                                     color=C_RED)
    ws.merge_cells(f"A{r_c+1}:D{r_c+1}")
    ws.cell(r_c + 1, 1).alignment = ctr()

    for i, (sym, meaning) in enumerate([
        ("p", "Overall mobile fraction (0 ≤ p ≤ 1)"),
        ("f", "Weight of Process 2 (0 ≤ f ≤ 1);  f=0 gives single-component"),
        ("EISF1(Q)", "EISF of Process 1 — select model in fitting sheet dropdown"),
        ("EISF2(Q)", "EISF of Process 2 — select model in fitting sheet dropdown"),
        ("(1−p)", "Immobile fraction — always contributes EISF = 1"),
    ]):
        ws.cell(r_c + 2 + i, 1).value = sym
        ws.cell(r_c + 2 + i, 1).font  = Font(name="Arial", size=10, bold=True)
        ws.cell(r_c + 2 + i, 2).value = meaning
        ws.cell(r_c + 2 + i, 2).font  = Font(name="Arial", size=10)
        ws.merge_cells(f"B{r_c+2+i}:D{r_c+2+i}")

    ws.sheet_properties.tabColor = "1F4E79"


